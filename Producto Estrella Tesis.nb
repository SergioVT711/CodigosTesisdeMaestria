         RowBox[{"Sqrt", "[", "j", "]"}]}]}], ")"}]}], "*)"}], 
    RowBox[{
     RowBox[{"expandido", "=", 
      RowBox[{"PowerExpand", "[", "expr", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "2.", " ", "Agrupar", " ", "por", " ", "la", " ", "base", " ", 
       "tensorial", " ", "Dsim", " ", "y", " ", "factorizar", " ", "los", " ",
        "coeficientes", " ", "en", " ", "j"}], "*)"}], 
     RowBox[{"Collect", "[", 
      RowBox[{"expandido", ",", "_Dsim", ",", 
       RowBox[{
        RowBox[{"Factor", "[", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{"#", ",", 
           RowBox[{"Assumptions", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Element", "[", 
               RowBox[{"j", ",", "Integers"}], "]"}], ",", 
              RowBox[{"j", ">=", "2"}]}], "}"}]}]}], "]"}], "]"}], "&"}]}], 
      "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{4.002162571814908*^9},
 CellLabel->"In[44]:=",ExpressionUUID->"b9f1ab9e-fd05-430b-8bb6-4ca8209f9fc1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FactorizarTotal", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "exprLimpia", "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "1.", " ", "Corregir", " ", "signos", " ", "y", " ", "simplificar", " ",
        "dentro", " ", "de", " ", "los", " ", "radicales", " ", "bajo", " ", 
       "j"}], ">=", "2"}], "*)"}], 
    RowBox[{
     RowBox[{"exprLimpia", "=", 
      RowBox[{"PowerExpand", "[", 
       RowBox[{"expr", "/.", " ", 
        RowBox[{
         RowBox[{"Sqrt", "[", "a_", "]"}], ":>", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{"a", ",", 
            RowBox[{"Assumptions", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Element", "[", 
                RowBox[{"j", ",", "Integers"}], "]"}], ",", 
               RowBox[{"j", ">=", "2"}]}], "}"}]}]}], "]"}], "]"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "2.", " ", "Agrupar", " ", "por", " ", "la", " ", "base", " ", 
       "tensorial", " ", "_Dsim"}], "*)"}], 
     RowBox[{"Collect", "[", 
      RowBox[{"exprLimpia", ",", "_Dsim", ",", 
       RowBox[{"Function", "[", 
        RowBox[{"coefD", ",", 
         RowBox[{"(*", 
          RowBox[{
          "3.", " ", "Agrupar", " ", "por", " ", "las", " ", "amplitudes", 
           " ", "simb\[OAcute]licas", " ", 
           RowBox[{"F", "[", "...", "]"}], " ", "y", " ", 
           RowBox[{"G", "[", "...", "]"}]}], "*)"}], 
         RowBox[{"Collect", "[", 
          RowBox[{"coefD", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"F", "[", "_", "]"}], ",", 
             RowBox[{"G", "[", "_", "]"}], ",", 
             RowBox[{"h", "[", "_", "]"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{"Factor", "[", 
             RowBox[{"FullSimplify", "[", 
              RowBox[{
               RowBox[{"PowerExpand", "[", "#", "]"}], ",", 
               RowBox[{"Assumptions", "->", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Element", "[", 
                   RowBox[{"j", ",", "Integers"}], "]"}], ",", 
                  RowBox[{"j", ">=", "2"}]}], "}"}]}]}], "]"}], "]"}], 
            "&"}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  4.0021637820847464`*^9, {4.003258059447954*^9, 4.0032580696113663`*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"faa91ae5-758e-47a8-8f02-3047ff702d7e"],

